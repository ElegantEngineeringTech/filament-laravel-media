{
  "name": "elegantly/filament-media-plugin",
  "description": "Filament support for `elegantly/laravel-media`.",
  "license": "MIT",
  "homepage": "https://github.com/ElegantEngineeringTech/filament-laravel-media",
  "support": {
    "issues": "https://github.com/ElegantEngineeringTech/filament-laravel-media/issues",
    "source": "https://github.com/ElegantEngineeringTech/filament-laravel-media"
  },
  "require": {
    "php": "^8.2",
    "filament/support": "^5.0.0",
    "elegantly/laravel-media": "^4.0||^5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.14"
  },
  "autoload": {
    "psr-4": {
      "Filament\\": "src"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint"
  }
}
